{
  "name": "krita-mcp-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "call": "node server/call.mjs",
    "worker": "node scripts/start-worker.mjs",
    "test:python": "python3 krita_plugin/test_validation.py && python3 krita_plugin/test_regions.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  },
  "description": "Local MCP server for Krita: editable layers, masks, color correction and PNG/KRA exports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/moseskm98-code/krita-mcp-bridge.git"
  },
  "homepage": "https://github.com/moseskm98-code/krita-mcp-bridge",
  "bugs": {
    "url": "https://github.com/moseskm98-code/krita-mcp-bridge/issues"
  },
  "keywords": [
    "krita",
    "mcp",
    "mcp-server",
    "image-editing"
  ]
}
